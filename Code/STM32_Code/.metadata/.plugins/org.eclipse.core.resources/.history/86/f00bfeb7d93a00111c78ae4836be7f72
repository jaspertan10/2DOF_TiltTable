bool x_reading_in_range(int x_input)
{
	return (x_input >= X_ADC_VALID_MIN && x_input <= X_ADC_VALID_MAX);


}



bool y_reading_in_range(int y_input)
{
	return (y_input >= Y_ADC_VALID_MIN && y_input <= Y_ADC_VALID_MAX);
}























































