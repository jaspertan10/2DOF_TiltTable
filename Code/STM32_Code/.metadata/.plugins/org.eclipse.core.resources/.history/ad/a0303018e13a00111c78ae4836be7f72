/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
#if (DEBUG_MODE != 0)
	int temp_tilt = 0;
	uint8_t tx_buf[100] = {0};
	int len = 0;
#endif

	uint32_t last_loop_time;

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ADC_Init();
  MX_TIM16_Init();
  MX_USART2_UART_Init();


  /* USER CODE BEGIN 2 */
  last_loop_time = HAL_GetTick();

  // Enable timer for us delays
  HAL_TIM_Base_Start(&htim16);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
#if (DEBUG_MODE != 0)
	  temp_tilt = read_tilt_x_position();
	  len = snprintf((char *)tx_buf, sizeof(tx_buf), "X: %d         ", temp_tilt);
	  HAL_UART_Transmit(&huart2, tx_buf, len, 1000);

	  temp_tilt = read_tilt_y_position();
	  len = snprintf((char *)tx_buf, sizeof(tx_buf), "Y: %d\n", temp_tilt);
	  HAL_UART_Transmit(&huart2, tx_buf, len, 1000);
	  HAL_Delay(500);
#endif
    /* USER CODE END WHILE */
    /* USER CODE BEGIN 3 */

	  //100Hz control loop
	  if ((HAL_GetTick() - LOOP_PERIOD_MS) < last_loop_time)
	  {
		  //Wait until LOOP_PERIOD_MS (10ms) has passed
		  continue;
	  }
	  last_loop_time = HAL_GetTick();

	  // Fixed dt in seconds
	  const float dt = LOOP_PERIOD_MS / 1000.0;

	  // Raw reads
	  int raw_x = read_tilt_x_position();
	  int raw_y = read_tilt_y_position();

	  // Start fitlered values as raw
	  int filtered_x = raw_x;
	  int filtered_y = raw_y;

	  // Ensure x and y values are within accepted ranges
	  bool x_range_valid = x_reading_in_range(raw_x);
	  bool y_range_valid = y_reading_in_range(raw_y);

	  // Check if values jump (commonly caused by ball not having enough pressure, i.e. unreliable contact -> jump in reading)
	  bool x_jump_valid = (abs(raw_x - last_good_x) <= X_MAX_STEP);
	  bool y_jump_valid = (abs(raw_y - last_good_y) <= Y_MAX_STEP);


	  // If ball has been picked up and placed, set as new position
	  if (ball_bad_read_count >= BALL_BAD_READ_THRESHOLD)
	  {
		  x_jump_valid = true;
		  y_jump_valid = true;
		  integral_x = 0.0;
		  integral_y = 0.0;
	  }


	  bool good_read = (x_range_valid && x_jump_valid) && (y_range_valid && y_jump_valid);


	  /*** Sensor filtering ***/
	  if (good_read)
	  {
		  //If read is valid, set good x and y points as current raw values
		  last_good_x = raw_x;
		  last_good_y = raw_y;
		  ball_bad_read_count = 0;
	  }
	  else
	  {
		  //Else set filtered x and y to the previous good read point
		  filtered_x = last_good_x;
		  filtered_y = last_good_y;
	  }

	  /*** PID ***/
	  float error_x = setpoint_x_position - filtered_x;
	  float error_y = setpoint_y_position - filtered_y;


	  // Integral term - only accumulates within an active band
	  // No zero reset near set point so accumulated values holds against steady state bias
	  if (good_read && abs(error_x) <= INTEGRAL_ACTIVE_BAND)
	  {
		  integral_x += error_x + dt;
	  }
	  if (good_read && abs(error_y) <= INTEGRAL_ACTIVE_BAND)
	  {
		  integral_y += error_y + dt;
	  }

	  // Anti windup clamp
	  if (integral_x > INTEGRAL_LIMIT_X) integral_x = INTEGRAL_LIMIT_X;
	  if (integral_x < -INTEGRAL_LIMIT_X) integral_x = -INTEGRAL_LIMIT_X;
	  if (integral_y > INTEGRAL_LIMIT_Y) integral_y = INTEGRAL_LIMIT_Y;
	  if (integral_y < -INTEGRAL_LIMIT_Y) integral_y = -INTEGRAL_LIMIT_Y;


	  // Derivative term - low pass filtered to reduce noise spikes
	  float raw_dx = (error_x - last_error_x) / dt;
	  float raw_dy = (error_y - last_error_y) / dt;

	  // Low pass filter
	  derivative_x = D_FILTER_ALPHA * raw_dx + (1.0 - D_FILTER_ALPHA) * filter_x;
	  derivative_y = D_FILTER_ALPHA * raw_dy + (1.0 - D_FILTER_ALPHA) * filter_y;


	  /***** PID Output *****/
	  float output_x = (KpX * error_x) + (KiX * integral_x) + (KdX * derivative_x);
	  float output_y = (KpY * error_y) + (KiY * integral_y) + (KdY * derivative_y);


	  //Save errors for next loop
	  last_error_x = error_x;
	  last_error_y = error_y;


	  //Servo commands
	  //todo: implement servo commands


  }
  /* USER CODE END 3 */
}

